# relcc2 tools/distro: busybox init.  The consoles get a root shell
# without a password (the BMC's serial console is ttyS1, the VGA tty1);
# SSH takes only relcc2's key.
::sysinit:/etc/init.d/rcS
ttyS1::respawn:/sbin/getty -n -l /bin/sh -L 115200 ttyS1 vt100
tty1::respawn:/sbin/getty -n -l /bin/sh 38400 tty1
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
