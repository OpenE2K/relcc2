# SPDX-License-Identifier: GPL-3.0-or-later
#
# DejaGnu board: the Elbrus-8C2 (v5, Elbrus Linux) over SSH; e2k-ssh.exp
# with this machine's defaults.
#
# Usage (with DEJAGNU pointing at tools/dejagnu/site.exp):
#   runtest --target_board=e2k-8c2 ...
#
# Settings besides e2k-ssh.exp's (Tcl variable, else environment):
#   E2K_8C2_HOST  [user@]host (default claude@geofront.lan)
#   E2K_8C2_PORT  ssh port (default: ssh's)
# E2K_LCC defaults to lcc's 8C2 build, e2k-v5.8c2.
#
# A shared machine (8 cores): keep make -j at 4 or less.

source [file join [file dirname [info script]] e2k-common.tcl]

set_board_info e2k,host [e2k_setting E2K_8C2_HOST claude@geofront.lan]
set_board_info e2k,port [e2k_setting E2K_8C2_PORT]
set_board_info e2k,lcc [e2k_setting E2K_LCC [e2k_lcc_dir e2k-v5.8c2]]

source [file join [file dirname [info script]] e2k-ssh.exp]
